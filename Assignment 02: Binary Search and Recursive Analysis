#include <iostream>
using namespace std;

// Iterative binary search
int BinarySearch_I(const int* numbers, int numbersSize, int key, int& comp) {
    comp = 0;
    int low = 0;
    int high = numbersSize - 1;
    while (low <= high) {
        int mid = (low + high) / 2;
        comp++;  // count each comparison of numbers[mid] to key
        if (numbers[mid] < key) {
            low = mid + 1;
        } else if (numbers[mid] > key) {
            high = mid - 1;
        } else {
            return mid;
        }
    }
    return -1;
}

// Recursive binary search
int BinarySearch_R(const int* numbers, int low, int high, int key, int& comp) {
    if (low > high) return -1;
    int mid = (low + high) / 2;
    comp++;  // count each comparison
    if (numbers[mid] < key) {
        return BinarySearch_R(numbers, mid + 1, high, key, comp);
    } else if (numbers[mid] > key) {
        return BinarySearch_R(numbers, low, mid - 1, key, comp);
    }
    return mid;
}

// Linear search
int linSearch(const int* numbers, int n, int target, int& comp) {
    comp = 0;
    for (int i = 0; i < n; i++) {
        comp++;
        if (numbers[i] == target)
            return i;
    }
    return -1;
}

